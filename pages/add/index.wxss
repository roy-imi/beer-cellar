.page {
  padding: 24rpx;
  background: #f7f2e8;
  min-height: 100vh;
}

.top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.title {
  display: block;
  color: #1f1f1f;
  font-size: 52rpx;
  font-weight: 900;
  line-height: 1;
}

.panel {
  padding: 22rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 12rpx;
  background: #ffffff;
}

.editor {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.row {
  display: grid;
  gap: 14rpx;
}

.two {
  grid-template-columns: 1fr 1fr;
}

.three {
  grid-template-columns: 130rpx 1fr 160rpx;
}

.field,
.select {
  width: 100%;
  min-width: 0;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 12rpx;
  background: #ffffff;
  color: #1f1f1f;
  font-size: 28rpx;
  box-sizing: border-box;
}

.select {
  display: flex;
  align-items: center;
}

.size-control {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 92rpx;
  align-items: center;
  min-width: 0;
  min-height: 82rpx;
  overflow: hidden;
  border: 2rpx solid #ded2b5;
  border-radius: 12rpx;
  background: #ffffff;
}

.size-input {
  width: 100%;
  min-width: 0;
  min-height: 82rpx;
  padding: 0 18rpx 0 22rpx;
  border: 0;
  background: transparent;
  color: #1f1f1f;
  font-size: 28rpx;
}

.unit-select {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  padding: 0 8rpx;
  overflow: hidden;
  border-left: 2rpx solid #eee2c7;
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 400;
  white-space: nowrap;
}

.suggest-field {
  position: relative;
}

.suggestions {
  display: flex;
  flex-wrap: nowrap;
  gap: 10rpx;
  margin-top: 12rpx;
  overflow-x: auto;
  padding-bottom: 4rpx;
}

.suggestion {
  flex: 0 0 auto;
  min-height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 999rpx;
  background: #fff8e4;
  color: #1f1f1f;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 54rpx;
  white-space: nowrap;
}

.suggestion::after {
  border: 0;
}

.hop-picker .suggestions {
  flex-wrap: wrap;
  overflow-x: visible;
}

.suggestion.selected {
  border-color: #1f1f1f;
  background: #ffc000;
  color: #1f1f1f;
}

.beer-suggestions {
  align-items: stretch;
}

.beer-suggestion {
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 280rpx;
  max-width: 420rpx;
  min-height: 76rpx;
  line-height: 1.2;
}

.suggestion-name,
.suggestion-detail {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.suggestion-name {
  font-size: 24rpx;
}

.suggestion-detail {
  margin-top: 4rpx;
  color: #6b6251;
  font-size: 20rpx;
  font-weight: 700;
}

.photo-box {
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  align-items: stretch;
  gap: 12rpx;
  min-width: 0;
}

.rating-lookup {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 120rpx;
  gap: 12rpx;
  min-width: 0;
}

.rating-lookup .field {
  min-width: 0;
}

.photo-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 220rpx;
  overflow: hidden;
  border: 2rpx solid #1f1f1f;
  border-radius: 12rpx;
  background: #f7f2e8;
  color: rgba(29, 37, 32, 0.34);
  font-size: 24rpx;
  font-weight: 900;
}

.photo-preview image {
  width: 100%;
  height: 100%;
}

.photo-actions {
  display: flex;
  flex-direction: column;
  justify-content: stretch;
  gap: 12rpx;
  min-width: 0;
}

.btn {
  display: block;
  max-width: 100%;
  min-height: 82rpx;
  padding-left: 12rpx;
  padding-right: 12rpx;
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 82rpx;
  box-sizing: border-box;
}

.lookup-btn {
  width: 100%;
  min-width: 0;
  min-height: 82rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 82rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-actions .btn,
.editor > .btn {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.photo-actions .btn {
  flex: 1 1 0;
  min-height: 0;
  line-height: 98rpx;
}

.btn::after {
  border: 0;
}

.primary {
  border: 2rpx solid #1f1f1f;
  background: #ffc000;
  color: #1f1f1f;
}

.secondary {
  border: 2rpx solid #ded2b5;
  background: #ffffff;
  color: #1f1f1f;
}

.small {
  min-width: 128rpx;
  min-height: 66rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  line-height: 66rpx;
}

.note-input {
  min-height: 150rpx;
  padding-top: 18rpx;
}

@media (max-width: 360px) {
  .two,
  .three,
  .photo-box,
  .rating-lookup {
    grid-template-columns: 1fr;
  }
}
