  color: #1f1f1f;
  font-size: 26rpx;
  font-weight: 900;
}

.calendar-summary-text {
  display: block;
  margin-top: 6rpx;
  color: #6b6251;
  font-size: 22rpx;
}

.calendar-summary-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.calendar-summary-tag {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1f1f1f;
  font-size: 20rpx;
  font-weight: 900;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
  line-height: 1.25;
}

.calendar-summary-tag.intake {
  background: #fff0b3;
  color: #6f5000;
}

.calendar-summary-tag.cellar-drink {
  background: #e4f3d6;
  color: #38621d;
}

.calendar-summary-tag.bar-drink {
  background: #dff4ee;
  color: #246852;
}

.calendar-event-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #e5dac2;
}

.calendar-event-row {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.calendar-event-type {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 36rpx;
  padding: 2rpx 6rpx;
  border-radius: 7rpx;
  font-size: 17rpx;
  font-weight: 900;
  line-height: 1.2;
  text-align: center;
}

.calendar-event-type.intake {
  background: #fff0b3;
  color: #6f5000;
}

.calendar-event-type.cellarDrink {
  background: #e4f3d6;
  color: #38621d;
}

.calendar-event-type.barDrink {
  background: #dff4ee;
  color: #246852;
}

.calendar-event-name {
  min-width: 0;
  color: #1f1f1f;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.calendar-event-legacy {
  padding: 3rpx 7rpx;
  border-radius: 6rpx;
  background: #eee7d8;
  color: #6b6251;
  font-size: 15rpx;
  font-weight: 800;
}

.calendar-event-more {
  color: #6b6251;
  font-size: 18rpx;
  line-height: 1.35;
  text-align: center;
}

.drawer-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.drawer-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 154rpx;
  padding: 18rpx 12rpx 16rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 18rpx;
  background: #fffdf8;
  text-align: center;
  transition: transform 120ms ease, background-color 120ms ease;
}

.drawer-grid-item-pressed {
  transform: scale(0.97);
  background: #fff8e4;
}

.drawer-grid-icon {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  border: 3rpx solid #1f1f1f;
  border-radius: 19rpx;
  background: #ffe39a;
  color: #1f1f1f;
  overflow: hidden;
}

.drawer-grid-icon.export {
  background: #e4f3d6;
}

.drawer-grid-icon.import {
  background: #dff4ee;
}

.drawer-grid-icon.storage {
  background: #ece6f5;
}

.feature-chart {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 5rpx;
  width: 44rpx;
  height: 42rpx;
  padding-bottom: 7rpx;
}

.feature-chart-bar {
  width: 7rpx;
  border: 3rpx solid #1f1f1f;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
  background: #fffdf8;
}

.feature-chart-bar.short {
  height: 13rpx;
}

.feature-chart-bar.medium {
  height: 23rpx;
}

.feature-chart-bar.tall {
  height: 34rpx;
}

.feature-chart-baseline {
  position: absolute;
  right: 1rpx;
  bottom: 5rpx;
  left: 1rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
}

.feature-transfer {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.feature-transfer-shaft {
  position: absolute;
  left: 20rpx;
  width: 4rpx;
  height: 25rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
}

.feature-transfer-head {
  position: absolute;
  left: 14rpx;
  width: 13rpx;
  height: 13rpx;
  border-style: solid;
  border-color: #1f1f1f;
  border-width: 4rpx 0 0 4rpx;
  transform: rotate(45deg);
}

.feature-transfer-tray {
  position: absolute;
  right: 2rpx;
  bottom: 1rpx;
  left: 2rpx;
  height: 18rpx;
  border: 4rpx solid #1f1f1f;
  border-top: 0;
  border-radius: 0 0 8rpx 8rpx;
}

.feature-transfer.export .feature-transfer-shaft {
  top: 3rpx;
}

.feature-transfer.export .feature-transfer-head {
  top: 3rpx;
}

.feature-transfer.import .feature-transfer-shaft {
  top: 8rpx;
}

.feature-transfer.import .feature-transfer-head {
  top: 17rpx;
  border-width: 0 4rpx 4rpx 0;
}

.feature-storage {
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.feature-storage-top {
  position: absolute;
  z-index: 2;
  top: 1rpx;
  left: 1rpx;
  width: 40rpx;
  height: 14rpx;
  border: 4rpx solid #1f1f1f;
  border-radius: 50%;
  background: #fffdf8;
}

.feature-storage-body {
  position: absolute;
  top: 8rpx;
  left: 1rpx;
  width: 40rpx;
  height: 33rpx;
  border: 4rpx solid #1f1f1f;
  border-top: 0;
  border-radius: 0 0 9rpx 9rpx;
}

.feature-storage-line {
  position: absolute;
  right: 0;
  left: 0;
  height: 3rpx;
  background: #1f1f1f;
}

.feature-storage-line.first {
  top: 9rpx;
}

.feature-storage-line.second {
  top: 19rpx;
}

.drawer-grid-label {
  margin-top: 12rpx;
  color: #1f1f1f;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.settings-card {
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}

.drawer-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  min-height: 86rpx;
  border-bottom: 2rpx solid #efe4c9;
}

.drawer-list-item:last-child {
  border-bottom: 0;
}

.drawer-list-label {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.35;
}

.drawer-list-arrow {
  color: #8c816f;
  font-size: 30rpx;
  font-weight: 900;
}

.bottom-navigation {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 12rpx;
  bottom: max(12rpx, calc(constant(safe-area-inset-bottom) - 24rpx));
  bottom: max(12rpx, calc(env(safe-area-inset-bottom) - 24rpx));
  z-index: 10;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 120rpx;
  align-items: center;
  gap: 14rpx;
}

.module-tabs {
  position: relative;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 4rpx;
  padding: 8rpx;
  border: 2rpx solid #d8ceba;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 12rpx 30rpx rgba(31, 31, 31, 0.13);
  box-sizing: border-box;
}

.module-tab {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  min-width: 0;
  min-height: 98rpx;
  padding: 8rpx 6rpx;
  border-radius: 999rpx;
  color: #5d5546;
}

.module-tab.active {
  background: #fff0b3;
  color: #1f1f1f;
  box-shadow: inset 0 -3rpx 0 #ffc000;
}

.record-fab {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 2rpx;
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #ffffff;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffd43b 0%, #f5ad00 100%);
  color: #1f1f1f;
  box-shadow: 0 12rpx 32rpx rgba(180, 120, 0, 0.28);
  box-sizing: border-box;
}

.record-fab:active {
  transform: scale(0.96);
}

.record-fab-plus {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.record-fab-plus::before,
.record-fab-plus::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 26rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: currentColor;
  transform: translate(-50%, -50%);
}

.record-fab-plus::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.record-fab-label {
  font-size: 23rpx;
  font-weight: 900;
  line-height: 1.2;
}

.record-menu-layer {
  position: fixed;
  inset: 0;
  z-index: 70;
  padding: 0;
  background: rgba(24, 22, 18, 0.76);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  box-sizing: border-box;
}

.record-menu-content {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  bottom: calc(142rpx + constant(safe-area-inset-bottom));
  bottom: calc(142rpx + env(safe-area-inset-bottom));
  width: auto;
  max-width: 620rpx;
  margin: 0 auto;
}

.record-menu-title,
.record-menu-subtitle {
  display: block;
  color: #ffffff;
  text-align: center;
}

.record-menu-title {
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.record-menu-subtitle {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 20rpx;
  line-height: 1.4;
}

.record-menu-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28rpx;
  margin-top: 22rpx;
}

.record-menu-action {
  display: flex;
  align-items: center;
  flex-direction: column;
  min-width: 0;
}

.record-menu-action:active .record-menu-icon-tile {
  transform: scale(0.95);
}

.record-menu-icon-tile {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 112rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 30rpx;
  color: #ffffff;
  box-shadow: 0 16rpx 34rpx rgba(0, 0, 0, 0.22);
  box-sizing: border-box;
}

.record-menu-icon-tile.cellar {
  background: linear-gradient(145deg, #ffd84d 0%, #d89b00 100%);
}

.record-menu-icon-tile.bar {
  background: linear-gradient(145deg, #62d0ae 0%, #278a6b 100%);
}

.record-menu-icon-tile .module-tab-icon {
  transform: scale(1.32);
}

.record-menu-action-label,
.record-menu-action-hint {
  display: block;
  text-align: center;
}

.record-menu-action-label {
  margin-top: 10rpx;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
}

.record-menu-action-hint {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 18rpx;
  line-height: 1.35;
}

.record-menu-close {
  position: absolute;
  left: 50%;
  bottom: calc(20rpx + constant(safe-area-inset-bottom));
  bottom: calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(0, 0, 0, 0.2);
  transform: translateX(-50%);
}

.record-menu-close-mark {
  position: relative;
  width: 30rpx;
  height: 30rpx;
}

.record-menu-close-mark::before,
.record-menu-close-mark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 32rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
  transform: translate(-50%, -50%) rotate(45deg);
}

.record-menu-close-mark::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.module-tab-icon {
  position: relative;
  width: 46rpx;
  height: 42rpx;
  color: currentColor;
  box-sizing: border-box;
}

.module-tab-label {
  color: currentColor;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 24rpx;
  text-align: center;
}

.module-tab.active .module-tab-label {
  font-weight: 900;
}

.cellar-bottle,
.cellar-shelf-line,
.favorites-heart,
.favorites-spark,
.bar-glass,
.bar-cheers-mark {
  position: absolute;
  box-sizing: border-box;
}

.cellar-bottle {
  bottom: 6rpx;
  width: 13rpx;
  height: 25rpx;
  border: 3rpx solid currentColor;
  border-radius: 5rpx 5rpx 3rpx 3rpx;
}

.cellar-bottle::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: -10rpx;
  width: 5rpx;
  height: 10rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 2rpx 2rpx 0 0;
  box-sizing: border-box;
}

.cellar-bottle::after {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 8rpx;
  width: 5rpx;
  border-top: 3rpx solid currentColor;
}

.cellar-bottle-left {
  left: 7rpx;
  height: 23rpx;
}

.cellar-bottle-right {
  right: 7rpx;
}

.cellar-shelf-line {
  left: 3rpx;
  bottom: 1rpx;
  width: 40rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.favorites-heart {
  left: 1rpx;
  top: -5rpx;
  width: 41rpx;
  color: currentColor;
  font-family: Arial, sans-serif;
  font-size: 41rpx;
  font-weight: 600;
  line-height: 42rpx;
  text-align: center;
}

.favorites-spark {
  border-radius: 999rpx;
  background: currentColor;
}

.favorites-spark::after {
  content: "";
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  background: inherit;
  transform: translate(-50%, -50%) rotate(90deg);
}

.favorites-spark-large {
  right: 1rpx;
  top: 4rpx;
  width: 3rpx;
  height: 10rpx;
}

.favorites-spark-large::after {
  width: 10rpx;
  height: 3rpx;
}

.favorites-spark-small {
  left: 2rpx;
  bottom: 6rpx;
  width: 3rpx;
  height: 6rpx;
}

.favorites-spark-small::after {
  width: 6rpx;
  height: 3rpx;
}

.bar-glass {
  bottom: 5rpx;
  width: 17rpx;
  height: 27rpx;
  border: 3rpx solid currentColor;
  border-radius: 3rpx 3rpx 6rpx 6rpx;
  transform-origin: center bottom;
}

.bar-glass::before {
  content: "";
  position: absolute;
  left: 2rpx;
  top: 6rpx;
  width: 7rpx;
  border-top: 3rpx solid currentColor;
}

.bar-glass-left {
  left: 6rpx;
  transform: rotate(-12deg);
}

.bar-glass-right {
  right: 6rpx;
  transform: rotate(12deg);
}

.bar-cheers-mark {
  left: 21rpx;
  top: 1rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.bar-cheers-mark::before,
.bar-cheers-mark::after {
  content: "";
  position: absolute;
  top: 4rpx;
  width: 4rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: currentColor;
}

.bar-cheers-mark::before {
  left: -9rpx;
  transform: rotate(-48deg);
}

.bar-cheers-mark::after {
  right: -9rpx;
  transform: rotate(48deg);
}

.suggest-field {
  position: relative;
}

.form-section-title {
  margin-top: 4rpx;
  color: #80621c;
  font-size: 22rpx;
  font-weight: 900;
}

.bar-location-row,
