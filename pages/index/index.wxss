  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.common-selector-result-secondary {
  color: #7c725f;
  font-size: 20rpx;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.common-selector-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 16rpx 28rpx 18rpx;
  border-top: 2rpx solid #eee2c7;
  background: #fffdf8;
  color: #6b6251;
  font-size: 22rpx;
  font-weight: 800;
}

.common-selector-confirm {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 180rpx;
  min-height: 68rpx;
  padding: 10rpx 24rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 999rpx;
  background: #ffc000;
  color: #1f1f1f;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

@media (max-width: 390px) {
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .intake-scan-card {
    grid-template-columns: 68rpx minmax(0, 1fr);
  }

  .intake-scan-btn,
  .intake-scan-status,
  .intake-scan-privacy {
    grid-column: 1 / 3;
    width: 100%;
  }

  .option-library-manage-item {
    grid-template-columns: minmax(0, 1fr);
  }

  .option-library-actions {
    justify-content: flex-start;
    max-width: none;
  }

  .panel-head {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .panel-head > .sort-control {
    max-width: 100%;
  }

  .with-action {
    flex-direction: column;
  }

  .with-action .small {
    width: 100%;
    max-width: 100%;
  }

  .quantity-quick-row {
    align-items: flex-start;
    flex-direction: column;
  }

  .quantity-quick-options {
    justify-content: flex-start;
    width: 100%;
  }

  .filter-row,
  .two,
  .three,
  .photo-box,
  .rating-lookup,
  .bar-location-row,
  .bar-style-rating-row {
    grid-template-columns: 1fr;
  }

  .item,
  .preview-item {
    grid-template-columns: 82rpx minmax(0, 1fr);
  }

  .group-item {
    grid-template-columns: 82rpx minmax(0, 1fr);
  }

  .cover {
    width: 82rpx;
    height: 82rpx;
  }

  .item-side,
  .preview-item .freshness {
    grid-column: 2;
  }

  .favorite-batch-list {
    grid-column: 2;
  }

  .batch-row {
    grid-template-columns: minmax(0, 1fr) 128rpx;
    padding-left: 0;
  }

  .drunk-item .batch-row {
    grid-template-columns: minmax(0, 1fr) 92rpx;
  }

  .batch-freshness {
    grid-column: 1;
  }

  .batch-actions {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .actions.batch-actions .mini-btn {
    flex-basis: 38rpx;
    width: 38rpx;
  }

  .drunk-item .batch-actions {
    grid-column: 2;
    grid-row: 1;
  }

  .bar-item {
    grid-template-columns: minmax(0, 1fr);
  }

  .bar-beer-row {
    grid-template-columns: minmax(0, 1fr);
  }

  .bar-actions {
    justify-self: end;
    margin-top: 10rpx;
  }

  .utility-actions {
    grid-template-columns: 1fr;
  }

  .utility-setting-row {
    align-items: flex-start;
    flex-wrap: wrap;
  }

  .utility-setting-row picker {
    width: 100%;
  }

  .utility-picker {
    width: 100%;
  }

  .freshness-rule-inputs {
    grid-template-columns: 1fr;
  }
}
