.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(168rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 24rpx calc(168rpx + env(safe-area-inset-bottom));
  background: #f7f2e8;
}

.page.record-page {
  padding: 0 0 calc(24rpx + constant(safe-area-inset-bottom));
  padding: 0 0 calc(24rpx + env(safe-area-inset-bottom));
  background: #ffffff;
}

.topbar {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.menu-button {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
  width: 72rpx;
  height: 72rpx;
  padding: 0 16rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.menu-line {
  width: 100%;
  height: 4rpx;
  border-radius: 999rpx;
  background: #1f1f1f;
}

.topbar-copy {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.topbar-title {
  display: block;
  color: #1f1f1f;
  font-size: 44rpx;
  font-weight: 900;
  line-height: 1.2;
}

.topbar-subtitle {
  display: block;
  color: #6b6251;
  font-size: 22rpx;
  line-height: 1.4;
}

.module {
  min-height: 100%;
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  padding: 10rpx 0 22rpx;
}

.compact-hero {
  padding-bottom: 18rpx;
}

.title {
  display: block;
  color: #1f1f1f;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10rpx;
  margin-bottom: 18rpx;
  padding: 8rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 12rpx;
  background: #ffffff;
}

.tab {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  min-height: 68rpx;
  padding: 12rpx 8rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #5d5546;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  overflow-wrap: anywhere;
}

.tab::after {
  border: 0;
}

.tab.active {
  background: #ffc000;
  color: #1f1f1f;
}

.panel {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 12rpx;
  background: #ffffff;
}

.panel-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.panel-head > view {
  flex: 1 1 auto;
  min-width: 0;
}

.panel-head > .small {
  flex: 0 0 128rpx;
}

.panel-head > .sort-control {
  flex: 0 0 auto;
  min-width: 0;
  max-width: 220rpx;
}

.panel-head > .editor-head-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
  gap: 8rpx;
}

.panel-head > .stats-panel-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex: 0 0 auto;
  gap: 10rpx;
}

.stats-order-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 62rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 10rpx;
  background: #fff8e4;
  color: #6f5100;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
  box-sizing: border-box;
}

.editor-head-actions .small {
  flex: 0 0 auto;
  width: 112rpx;
  min-width: 112rpx;
  max-width: 112rpx;
}

.editor-back-btn {
  background: #fff8e4;
}

.record-page-editor {
  min-height: 100vh;
  margin: 0;
  padding: 0 24rpx 44rpx;
  border: 0;
  border-radius: 0;
  background: #ffffff;
  box-sizing: border-box;
}

.record-page-head {
  position: sticky;
  top: 0;
  z-index: 8;
  display: grid;
  grid-template-columns: minmax(120rpx, 1fr) auto minmax(120rpx, 1fr);
  align-items: center;
  min-height: 88rpx;
  margin: 0 -24rpx 8rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid #eee2c7;
  background: rgba(255, 255, 255, 0.97);
  box-sizing: border-box;
}

.record-page-back {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  min-height: 72rpx;
  color: #1f1f1f;
  font-size: 25rpx;
  font-weight: 900;
}

.record-page-back-icon {
  margin-top: -4rpx;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1;
}

.record-page-title {
  max-width: 330rpx;
  color: #1f1f1f;
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
  overflow-wrap: anywhere;
}

.record-page-clear {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 72rpx;
  color: #8c816f;
  font-size: 23rpx;
  font-weight: 800;
}

.panel-title,
.panel-subtitle {
  display: block;
}

.panel-title {
  color: #1f1f1f;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.3;
}

.panel-subtitle {
  margin-top: 6rpx;
  color: #6b6251;
  font-size: 24rpx;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.compact-stats {
  grid-template-columns: minmax(0, 1fr);
  margin-top: 14rpx;
}

.bar-summary {
  grid-template-columns: repeat(3, 1fr);
}

.stat {
  min-width: 0;
  padding: 18rpx 12rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 12rpx;
  background: #ffc000;
  text-align: center;
}

.stat-number,
.stat-label {
  display: block;
}

.stat-number {
  color: #1f1f1f;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.15;
}

.stat-label {
  margin-top: 4rpx;
  color: rgba(31, 31, 31, 0.72);
  font-size: 22rpx;
}

.dimension-section {
  margin-top: 16rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 10rpx;
  background: #fffdf8;
  overflow: hidden;
}

.stats-order-editor {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stats-order-hint {
  display: block;
  padding: 14rpx 16rpx;
  border-radius: 10rpx;
  background: #fff8e4;
  color: #6b6251;
  font-size: 21rpx;
  line-height: 1.45;
}

.stats-order-item {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr) 54rpx;
  align-items: center;
  gap: 12rpx;
  min-height: 86rpx;
  padding: 12rpx 14rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 12rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(31, 31, 31, 0.05);
  box-sizing: border-box;
  transition: transform 120ms ease, box-shadow 120ms ease, background 120ms ease;
}

.stats-order-item.dragging {
  z-index: 2;
  border-color: #d9a500;
  background: #fff8e4;
  box-shadow: 0 12rpx 28rpx rgba(126, 88, 0, 0.18);
  transform: scale(1.015);
}

.stats-order-number {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #ffc000;
  color: #1f1f1f;
  font-size: 21rpx;
  font-weight: 900;
}

.stats-order-title {
  color: #1f1f1f;
  font-size: 27rpx;
  font-weight: 900;
  overflow-wrap: anywhere;
}

.stats-order-handle {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 7rpx;
  width: 54rpx;
  min-height: 60rpx;
}

.stats-order-handle > view {
  width: 30rpx;
  height: 4rpx;
  border-radius: 999rpx;
  background: #7e7464;
}

.dimension-head,
.dimension-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 68rpx;
  padding: 12rpx 16rpx;
  border-bottom: 2rpx solid #eee2c7;
  color: #4d4538;
  font-size: 24rpx;
  line-height: 1.35;
}

.dimension-head {
  min-height: 62rpx;
  background: #fff8e4;
  color: #1f1f1f;
  font-weight: 900;
}

.dimension-row:last-child {
  border-bottom: 0;
}

.dimension-child-row {
  min-height: 54rpx;
  padding-left: 36rpx;
  background: #fffdf8;
  color: #6b6251;
  font-size: 22rpx;
}

.dimension-row-link {
  transition: background 120ms ease;
}

.dimension-row-pressed {
  background: #fff1c5;
}

.dimension-row > text:first-child {
  flex: 1 1 auto;
  min-width: 0;
  overflow-wrap: anywhere;
}

.dimension-head > text:last-child,
.dimension-row-value {
  flex: 0 0 auto;
  color: #1f1f1f;
  font-weight: 900;
  text-align: right;
}

.dimension-row-value {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  min-width: 128rpx;
}

.dimension-drill-icon {
  color: #8a6400;
  font-size: 34rpx;
  font-weight: 500;
  line-height: 1;
}

.preview-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 22rpx;
  margin-bottom: 6rpx;
}

.preview-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 900;
}

.link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  max-width: 220rpx;
  min-height: 52rpx;
  padding: 8rpx 12rpx;
  background: transparent;
  color: #8a6400;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.link-btn::after {
  border: 0;
}

.filters,
.editor {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.intake-scan-card {
  display: grid;
  grid-template-columns: 76rpx minmax(0, 1fr);
  align-items: center;
  gap: 14rpx;
  padding: 18rpx;
  border: 2rpx solid #1f1f1f;
  border-radius: 14rpx;
  background: #fff8e4;
}

.scan-camera-icon {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 14rpx;
  background: #ffc000;
}

.scan-camera-icon::before {
  content: "";
  position: absolute;
  left: 12rpx;
  top: 20rpx;
  width: 44rpx;
  height: 32rpx;
  border: 4rpx solid #1f1f1f;
  border-radius: 7rpx;
  box-sizing: border-box;
}

.scan-camera-icon::after {
  content: "";
  position: absolute;
  left: 27rpx;
  top: 27rpx;
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid #1f1f1f;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.intake-scan-copy {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  min-width: 0;
}

.intake-scan-title {
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 900;
}

.intake-scan-desc,
.intake-scan-privacy {
  color: #6b6251;
  font-size: 21rpx;
  line-height: 1.45;
}

.intake-scan-btn {
  grid-column: 1 / 3;
  width: 100%;
  min-width: 0;
  padding: 0 18rpx;
}

.intake-scan-btn.restart {
  border-color: #8a6400;
  background: #ffffff;
  color: #7a5b00;
}

.intake-scan-status {
  grid-column: 1 / 3;
  color: #7a5b00;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1.4;
}

.intake-scan-privacy {
  grid-column: 1 / 3;
}

.recognition-progress-card {
  padding: 18rpx;
  border: 2rpx solid #d2a000;
  border-radius: 14rpx;
  background: #fffdf7;
}

.recognition-progress-card.error {
  border-color: #c7523a;
  background: #fff7f4;
}

.recognition-progress-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.recognition-progress-indicator {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  border: 5rpx solid #ead8a0;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.recognition-progress-indicator.working {
  border-top-color: #8a6400;
  animation: recognition-spin 0.9s linear infinite;
}

.recognition-progress-indicator.error {
  border-color: #c7523a;
  color: #a23124;
  font-size: 24rpx;
  font-weight: 900;
}

.recognition-progress-copy {
  display: flex;
  flex: 1 1 auto;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.recognition-progress-title,
.recognition-progress-hint {
  display: block;
}

.recognition-progress-title {
  color: #1f1f1f;
  font-size: 26rpx;
  font-weight: 900;
}

.recognition-progress-hint {
  color: #6b6251;
  font-size: 21rpx;
  line-height: 1.45;
}

.recognition-progress-steps {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #eee2c7;
}

.recognition-progress-step {
  position: relative;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 7rpx;
  color: #9a907e;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
}

.recognition-progress-step::after {
  content: "";
  position: absolute;
  left: calc(50% + 15rpx);
  right: calc(-50% + 15rpx);
  top: 8rpx;
  height: 3rpx;
  border-radius: 999rpx;
  background: #ded2b5;
}

.recognition-progress-step:last-child::after {
  display: none;
}

.recognition-step-dot {
  position: relative;
  z-index: 1;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid #c8bfae;
  border-radius: 999rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.recognition-progress-step.active,
.recognition-progress-step.done {
  color: #5f490c;
}

.recognition-progress-step.active .recognition-step-dot {
  border-color: #1f1f1f;
  background: #ffc000;
  box-shadow: 0 0 0 5rpx rgba(255, 192, 0, 0.2);
}

.recognition-progress-step.done .recognition-step-dot,
.recognition-progress-step.done::after {
  border-color: #8a6400;
  background: #8a6400;
}

.recognition-error-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.recognition-error-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 66rpx;
  padding: 12rpx 14rpx;
  font-size: 23rpx;
  line-height: 1.3;
}

@keyframes recognition-spin {
  to {
    transform: rotate(360deg);
  }
}

.recognition-result-card {
  padding: 18rpx;
  border: 2rpx solid #d2a000;
  border-radius: 14rpx;
  background: #fffdf7;
}

.recognition-result-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.recognition-result-head > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.recognition-result-title {
  color: #1f1f1f;
  font-size: 27rpx;
  font-weight: 900;
}

.recognition-result-meta {
  color: #80621c;
  font-size: 21rpx;
  font-weight: 800;
}

.recognition-clear {
  flex: 0 0 auto;
  color: #80621c;
  font-size: 22rpx;
  font-weight: 900;
}

.recognition-field-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 14rpx;
}

.recognition-field-chip {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  max-width: 100%;
  padding: 7rpx 10rpx;
  border: 2rpx solid #eee2c7;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 21rpx;
}

.recognition-field-label {
  flex: 0 0 auto;
  color: #8c816f;
}

.recognition-field-value {
  flex: 1 1 160rpx;
  min-width: 0;
  color: #1f1f1f;
  font-weight: 800;
  line-height: 1.35;
  overflow-wrap: anywhere;
}

.recognition-warning-list {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx solid #f0e1ba;
}

.recognition-warning {
  color: #8a5f00;
  font-size: 21rpx;
  line-height: 1.45;
}

.intake-batch-title {
  margin-top: 10rpx;
}

.quantity-quick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.quantity-quick-label {
  flex: 0 0 auto;
  color: #6b6251;
  font-size: 22rpx;
  font-weight: 800;
}

.quantity-quick-options {
  display: flex;
  flex-wrap: wrap;
  flex: 1 1 auto;
  justify-content: flex-end;
  gap: 8rpx;
  min-width: 0;
}

.quantity-quick-option {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 48rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 9rpx;
  background: #ffffff;
  color: #5d5546;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.quantity-quick-option.active {
  border-color: #1f1f1f;
  background: #ffc000;
  color: #1f1f1f;
}

.intake-save-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
}

.intake-save-actions .btn {
  width: 100%;
}

.filters {
  margin-bottom: 18rpx;
}

.filter-row,
.row {
  display: grid;
  gap: 14rpx;
}

.filter-row picker,
.row picker {
  min-width: 0;
}

.filter-row {
  grid-template-columns: 1fr;
}

.two {
  grid-template-columns: 1fr 1fr;
}

.three {
  grid-template-columns: 130rpx 1fr 160rpx;
}

.field,
.select {
  width: 100%;
  min-width: 0;
  min-height: 82rpx;
  padding: 0 22rpx;
  border: 2rpx solid #ded2b5;
  border-radius: 10rpx;
  background: #ffffff;
  color: #1f1f1f;
  font-size: 28rpx;
  line-height: 1.35;
  box-sizing: border-box;
}

input.field {
  height: 82rpx;
  line-height: 82rpx;
}

.select {
  display: flex;
  align-items: center;
  padding-top: 12rpx;
  padding-bottom: 12rpx;
  overflow-wrap: anywhere;
}

.sort-select {
  display: flex;
  align-items: center;
  justify-content: center;
  width: auto;
  max-width: 250rpx;
  min-height: 60rpx;
  height: auto;
  padding: 10rpx 14rpx;
  border: 0;
  background: #ffc000;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
  text-align: center;
}

.size-control {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 104rpx;
  align-items: center;
  min-width: 0;
  min-height: 82rpx;
  overflow: hidden;
  border: 2rpx solid #ded2b5;
  border-radius: 10rpx;
  background: #ffffff;
}

.size-input {
  width: 100%;
  min-width: 0;
  min-height: 82rpx;
  padding: 0 18rpx 0 22rpx;
  border: 0;
  background: transparent;
  color: #1f1f1f;
  font-size: 28rpx;
  height: 82rpx;
  line-height: 82rpx;
}

.unit-select {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 82rpx;
  padding: 12rpx 8rpx;
  overflow: hidden;
  border-left: 2rpx solid #eee2c7;
  color: #1f1f1f;
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.2;
  text-align: center;
  white-space: nowrap;
}

.inventory {
  padding: 18rpx;
}

.empty {
  padding: 28rpx 0;
  color: #6b6251;
  font-size: 26rpx;
  text-align: center;
